l="Hyperlink"/><w:color w:val="auto"/><w:u w:val="none"/></w:rPr><w:t>University of Cincinnati - Housing &amp; Food Services</w:t></w:r></w:p><w:p w14:paraId="70CA9D69" w14:textId="2C575B31" w:rsidR="00D152D3" w:rsidRPr="00D152D3" w:rsidRDefault="002F32E4" w:rsidP="00D152D3"><w:r w:rsidRPr="002F32E4"><w:fldChar w:fldCharType="end"/></w:r><w:r w:rsidR="00D152D3" w:rsidRPr="00D152D3"><w:t xml:space="preserve">Dear Hiring Manager, </w:t></w:r></w:p><w:p w14:paraId="2805B89C" w14:textId="77777777" w:rsidR="00D152D3" w:rsidRPr="00D152D3" w:rsidRDefault="00D152D3" w:rsidP="00D152D3"><w:r w:rsidRPr="00D152D3"><w:t xml:space="preserve">I am writing to express my strong interest in the UC Housing Student Hiring Coordinator position at University of Cincinnati - Housing &amp; Food Services. With my background in IT leadership, combined with my hands-on experience in web development. I am well-prepared to contribute effectively to your team and enhance the hiring operations at your esteemed institution. </w:t></w:r></w:p><w:p w14:paraId="7E880F10" w14:textId="77777777" w:rsidR="00D152D3" w:rsidRPr="00D152D3" w:rsidRDefault="00D152D3" w:rsidP="00D152D3"><w:r w:rsidRPr="00D152D3"><w:t xml:space="preserve">In my recent role as Lead at Virtual Visionaries Pvt Ltd, I oversaw several projects that integrated software solutions with user-centric service approaches. Over the past 2 years, I have honed skills that are crucial for managing the multi-faceted demands of a hiring coordinator, such as analyzing data through dashboards, scheduling, and maintaining accurate records—all of which are essential duties outlined in the job description for this position. </w:t></w:r></w:p><w:p w14:paraId="44B6C336" w14:textId="0FEBF840" w:rsidR="00D152D3" w:rsidRPr="00D152D3" w:rsidRDefault="00D152D3" w:rsidP="00D152D3"><w:r w:rsidRPr="00D152D3"><w:t xml:space="preserve">My technical skills include C++, Java, HTML5, JavaScript, CSS, Angular6, React, Bootstrap, MySQL, MongoDB, and </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00D152D3"><w:t>Xampp</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00D152D3"><w:t xml:space="preserve">. These are complemented by my strengths in web development, team leadership, client satisfaction, entrepreneurial skills, data analysis, security analysis. I am confident that these skills will enable me to manage the application and screening processes effectively, enhance candidate communication, and optimize the hiring workflow at the University of Cincinnati. </w:t></w:r></w:p><w:p w14:paraId="326BC5C3" w14:textId="77777777" w:rsidR="00D152D3" w:rsidRPr="00D152D3" w:rsidRDefault="00D152D3" w:rsidP="00D152D3"><w:r w:rsidRPr="00D152D3"><w:t xml:space="preserve">I am eager to bring my background in IT management, combined with my passion for data-driven decision making and team collaboration, to the University of Cincinnati - Housing &amp; Food Services. I am excited about the opportunity to contribute to and grow with your esteemed team. </w:t></w:r></w:p><w:p w14:paraId="6B8E86D4" w14:textId="77777777" w:rsidR="00D152D3" w:rsidRPr="00D152D3" w:rsidRDefault="00D152D3" w:rsidP="00D152D3"><w:r w:rsidRPr="00D152D3"><w:t xml:space="preserve">I look forward to the possibility of discussing this exciting opportunity with you. Thank you for considering my application. </w:t></w:r></w:p><w:p w14:paraId="55D76DAC" w14:textId="77777777" w:rsidR="00D152D3" w:rsidRPr="00D152D3" w:rsidRDefault="00D152D3" w:rsidP="00D152D3"><w:r w:rsidRPr="00D152D3"><w:t xml:space="preserve">Best regards, </w:t></w:r></w:p><w:p w14:paraId="449746A9" w14:textId="77777777" w:rsidR="00D152D3" w:rsidRPr="00D152D3" w:rsidRDefault="00D152D3" w:rsidP="00D152D3"><w:r w:rsidRPr="00D152D3"><w:t>Tharun Medam</w:t></w:r></w:p><w:p w14:paraId="0C2101B8" w14:textId="77777777" w:rsidR="00D152D3" w:rsidRDefault="00D152D3"/><w:sectPr w:rsidR="00D152D3"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>